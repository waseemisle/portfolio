rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "waseemisle@gmail.com";
    }

    // Site content — anyone can read (the public site needs it),
    // only the admin account can write.
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experience/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /education/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /skillGroups/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Visits — anyone can log their own visit (create only, no edits),
    // only the admin account can read the log.
    match /visits/{docId} {
      allow create: if request.resource.data.keys().hasAll(
        ["path", "referrer", "userAgent", "ip", "city", "region", "country", "createdAt"]
      );
      allow read, update, delete: if isAdmin();
    }
  }
}
